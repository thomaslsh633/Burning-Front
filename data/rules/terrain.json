{
  "about": "Terrain for movement, cover and sight (values from v214 GROUND_DEFS / OBJ_DEFS / EDGE_DEFS). A hex has one ground and at most one object; a hex edge may hold an edge object. cost: move points to enter (per move class); null = impassable. cross: extra move points to cross an edge; null = cannot cross. sight: none | partial | block. height: 0–3, compared with the viewer later.",
  "pass_classes": {
    "infantry": "infantry", "vaulting_infantry": "infantry",
    "vehicle_ultra_light": "vehicle", "vehicle_light": "vehicle", "vehicle_medium": "vehicle",
    "trench_crossing_vehicle_light": "vehicle", "trench_crossing_vehicle_medium": "vehicle", "trench_crossing_vehicle_heavy": "vehicle"
  },
  "default_ground": "plains",
  "ground": {
    "plains": { "cost": { "infantry": 1, "vehicle": 2 } },
    "road": { "cost": { "infantry": 1, "vehicle": 1 } },
    "cobblestone": { "cost": { "infantry": 1, "vehicle": 1 } },
    "field": { "cost": { "infantry": 1, "vehicle": 2 } },
    "snow": { "cost": { "infantry": 2, "vehicle": 2 } },
    "ice": { "cost": { "infantry": 2, "vehicle": 1 } },
    "desert": { "cost": { "infantry": 2, "vehicle": 2 } },
    "shallow_water": { "cost": { "infantry": 2, "vehicle": 3 }, "cover": "water" },
    "deep_water": { "cost": { "infantry": null, "vehicle": null }, "cover": "water" }
  },
  "objects": {
    "crater": { "cover": "light", "sight": "none", "height": 0, "cost": { "infantry": 1, "vehicle": 2 } },
    "trench": { "cover": "heavy", "sight": "none", "height": 0, "cost": { "infantry": 1, "vehicle": 3 } },
    "bush": { "cover": "light", "sight": "none", "height": 1, "cost": { "infantry": 1, "vehicle": 2 } },
    "dune": { "cover": "light", "sight": "none", "height": 1, "cost": { "infantry": 2, "vehicle": 3 } },
    "rubble": { "cover": "light", "sight": "partial", "height": 2, "cost": { "infantry": 1, "vehicle": 3 } },
    "forest_light": { "cover": "light", "sight": "partial", "height": 3, "cost": { "infantry": 2, "vehicle": 2 } },
    "forest": { "cover": "light", "sight": "block", "height": 3, "cost": { "infantry": 2, "vehicle": 3 } },
    "forest_dense": { "cover": "heavy", "sight": "block", "height": 3, "cost": { "infantry": 2, "vehicle": null } },
    "rock": { "cover": "heavy", "sight": "block", "height": 3, "cost": { "infantry": 3, "vehicle": null } },
    "building": { "cover": "heavy", "sight": "block", "height": 3, "cost": { "infantry": 1, "vehicle": null } }
  },
  "edges": {
    "hedge": { "cover": "light", "sight": "partial", "height": 2, "cross": { "infantry": 1, "vehicle": 1 } },
    "fence": { "cover": "none", "sight": "none", "height": 1, "cross": { "infantry": 0, "vehicle": 0 } },
    "stone_wall": { "cover": "heavy", "sight": "block", "height": 2, "cross": { "infantry": 1, "vehicle": null } },
    "sandbag_row": { "cover": "heavy", "sight": "none", "height": 1, "cross": { "infantry": 1, "vehicle": 1 } },
    "wire": { "cover": "none", "sight": "none", "height": 1, "cross": { "infantry": 2, "vehicle": 0 } },
    "low_wall": { "cover": "light", "sight": "none", "height": 1, "cross": { "infantry": 1, "vehicle": 1 } },
    "balustrade": { "cover": "light", "sight": "none", "height": 1, "cross": { "infantry": 1, "vehicle": null } }
  }
}
