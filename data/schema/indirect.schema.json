{
  "type": "object",
  "required": [
    "classes",
    "blind",
    "counter_battery"
  ],
  "additionalProperties": false,
  "properties": {
    "about": {
      "type": "string"
    },
    "classes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "patterns",
          "usage_turns",
          "range_cap_hex",
          "spread_hex",
          "min_range_floor_hex"
        ],
        "additionalProperties": false,
        "properties": {
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "usage_turns": {
            "type": "integer",
            "minimum": 1
          },
          "range_cap_hex": {
            "$ref": "types.schema.json#/$defs/HexInt"
          },
          "spread_hex": {
            "$ref": "types.schema.json#/$defs/HexInt"
          },
          "min_range_floor_hex": {
            "$ref": "types.schema.json#/$defs/HexInt"
          },
          "max_shells": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "blind": {
      "type": "object",
      "required": [
        "extra_spread_hex",
        "default_fow_multiplier"
      ],
      "additionalProperties": false,
      "properties": {
        "extra_spread_hex": {
          "type": "integer",
          "minimum": 0
        },
        "default_fow_multiplier": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "counter_battery": {
      "type": "object",
      "required": [
        "mark_turns"
      ],
      "additionalProperties": false,
      "properties": {
        "mark_turns": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
