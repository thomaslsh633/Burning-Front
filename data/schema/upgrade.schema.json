{
  "about": "upgrade.json per faction: { <upgrade_category>: { <id>: upgrade } }.",
  "$defs": {
    "upgrade": {
      "type": "object",
      "properties": {
        "coh3_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "enum": [
            "unit",
            "player"
          ]
        },
        "cost": {
          "$ref": "types.schema.json#/$defs/Resources"
        },
        "build_turns": {
          "$ref": "types.schema.json#/$defs/Turns"
        },
        "requires": {
          "type": "object",
          "properties": {
            "upgrades": {
              "type": "array",
              "items": {
                "$ref": "types.schema.json#/$defs/Id"
              }
            },
            "buildings": {
              "type": "array",
              "items": {
                "$ref": "types.schema.json#/$defs/Id"
              }
            },
            "any_upgrades": {
              "type": "array",
              "items": {
                "$ref": "types.schema.json#/$defs/Id"
              }
            }
          },
          "additionalProperties": false
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "add_weapon"
                  },
                  "weapon": {
                    "$ref": "types.schema.json#/$defs/Id"
                  },
                  "members": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false,
                "required": [
                  "type",
                  "weapon"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "replace_weapon"
                  },
                  "from": {
                    "$ref": "types.schema.json#/$defs/Id"
                  },
                  "to": {
                    "$ref": "types.schema.json#/$defs/Id"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "type",
                  "from",
                  "to"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "stat"
                  },
                  "target": {
                    "type": "string"
                  },
                  "stat": {
                    "type": "string"
                  },
                  "mult": {
                    "type": "number"
                  },
                  "add": {
                    "type": "number"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "type",
                  "target",
                  "stat"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "add_ability"
                  },
                  "ability": {
                    "$ref": "types.schema.json#/$defs/Id"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "type",
                  "ability"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "add_trait"
                  },
                  "trait": {
                    "type": "string",
                    "vocab": "unit_trait"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "type",
                  "trait"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "unlock"
                  },
                  "sbps": {
                    "$ref": "types.schema.json#/$defs/Id"
                  },
                  "upgrade": {
                    "$ref": "types.schema.json#/$defs/Id"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "type"
                ]
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "coh3_ref",
        "scope",
        "cost",
        "effects"
      ]
    }
  },
  "type": "object",
  "propertyVocab": "upgrade_category",
  "properties": {
    "about": {
      "type": "string"
    }
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": {
      "$ref": "#/$defs/upgrade"
    }
  }
}
