{
  "about": "data/rules/production.json",
  "type": "object",
  "properties": {
    "about": { "type": "string" },
    "factions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "slots": {
            "type": "object",
            "propertyNames": { "pattern": "^(hq|t[1-3][a-z]?)$" },
            "additionalProperties": { "$ref": "types.schema.json#/$defs/Id" }
          },
          "tier2": { "$ref": "types.schema.json#/$defs/Id" },
          "buildings": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "slot": { "type": "string" },
                "base": { "$ref": "#/$defs/Ids" },
                "doctrine": { "$ref": "#/$defs/Ids" },
                "research": { "$ref": "#/$defs/Ids" }
              },
              "additionalProperties": false,
              "required": ["slot", "base", "doctrine", "research"]
            }
          }
        },
        "additionalProperties": false,
        "required": ["slots", "buildings"]
      }
    },
    "place": { "type": "object", "additionalProperties": { "$ref": "types.schema.json#/$defs/Id" } },
    "unlock": { "type": "object", "additionalProperties": { "enum": ["base", "doctrine", "research"] } }
  },
  "additionalProperties": false,
  "required": ["factions", "place", "unlock"],
  "$defs": { "Ids": { "type": "array", "items": { "$ref": "types.schema.json#/$defs/Id" } } }
}
