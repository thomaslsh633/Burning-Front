{
  "about": "data/rules/production.json",
  "type": "object",
  "properties": {
    "about": { "type": "string" },
    "types": {
      "type": "object",
      "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "types.schema.json#/$defs/Id" } }
    },
    "place": { "type": "object", "additionalProperties": { "$ref": "types.schema.json#/$defs/Id" } },
    "buildings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "squads": { "type": "array", "items": { "$ref": "types.schema.json#/$defs/Id" } },
          "research": { "type": "array", "items": { "$ref": "types.schema.json#/$defs/Id" } }
        },
        "additionalProperties": false,
        "required": ["squads", "research"]
      }
    }
  },
  "additionalProperties": false,
  "required": ["types", "place", "buildings"]
}
