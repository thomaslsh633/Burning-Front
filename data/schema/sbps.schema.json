{
  "about": "sbps.json per faction: { <unit_category>: { <id>: squad } }.",
  "$defs": {
    "squad": {
      "type": "object",
      "properties": {
        "coh3_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent": {
          "$ref": "types.schema.json#/$defs/Id"
        },
        "estimated": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "vocab": "kind"
        },
        "role": {
          "type": "string",
          "vocab": "role"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "entity": {
                "$ref": "types.schema.json#/$defs/Id"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "entity",
              "count"
            ]
          }
        },
        "price": {
          "type": "object",
          "properties": {
            "cost": {
              "$ref": "types.schema.json#/$defs/Resources"
            },
            "from": {
              "type": "string",
              "vocab": "price_source"
            }
          },
          "additionalProperties": false,
          "required": [
            "cost",
            "from"
          ]
        },
        "pop": {
          "type": "integer",
          "minimum": 0
        },
        "build_turns": {
          "$ref": "types.schema.json#/$defs/Turns"
        },
        "requires": {
          "type": "object",
          "properties": {
            "buildings": {
              "type": "array",
              "items": {
                "$ref": "types.schema.json#/$defs/Id"
              }
            },
            "upgrades": {
              "type": "array",
              "items": {
                "$ref": "types.schema.json#/$defs/Id"
              }
            },
            "cp": {
              "type": "integer",
              "minimum": 0
            },
            "doctrine": {
              "$ref": "types.schema.json#/$defs/Id"
            },
            "any_upgrades": {
              "type": "array",
              "items": {
                "$ref": "types.schema.json#/$defs/Id"
              }
            }
          },
          "additionalProperties": false
        },
        "upgrades": {
          "type": "object",
          "properties": {
            "slots": {
              "type": "integer"
            },
            "list": {
              "type": "array",
              "items": {
                "$ref": "types.schema.json#/$defs/Id"
              }
            },
            "pending": {
              "type": "array",
              "items": {
                "$ref": "types.schema.json#/$defs/Id"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "list"
          ]
        },
        "abilities": {
          "type": "array",
          "items": {
            "$ref": "types.schema.json#/$defs/Id"
          }
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string",
            "vocab": "unit_trait"
          }
        },
        "unique": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "vocab": "unit_source"
        },
        "capture": {
          "type": "object",
          "properties": {
            "rate": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "rate"
          ]
        },
        "reinforce": {
          "type": "object",
          "properties": {
            "cost_ratio": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "cost_ratio"
          ]
        },
        "veterancy": {
          "type": "object",
          "properties": {
            "set": {
              "$ref": "types.schema.json#/$defs/Id"
            }
          },
          "additionalProperties": false,
          "required": [
            "set"
          ]
        },
        "build": {
          "type": "object",
          "properties": {
            "menu": {
              "type": "array",
              "items": {
                "$ref": "types.schema.json#/$defs/Id"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "menu"
          ]
        },
        "team_weapon": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "weapon_entity": {
                  "$ref": "types.schema.json#/$defs/Id"
                },
                "crew_entity": {
                  "$ref": "types.schema.json#/$defs/Id"
                }
              },
              "additionalProperties": false,
              "required": [
                "weapon_entity",
                "crew_entity"
              ]
            },
            {
              "type": "object",
              "properties": {
                "weapon": {
                  "$ref": "types.schema.json#/$defs/Id"
                },
                "crew_entity": {
                  "$ref": "types.schema.json#/$defs/Id"
                }
              },
              "additionalProperties": false,
              "required": [
                "weapon",
                "crew_entity"
              ]
            }
          ]
        },
        "supply": {
          "type": "object",
          "properties": {
            "ammo": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "ammo"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "coh3_ref",
        "kind",
        "role",
        "members",
        "price",
        "pop"
      ]
    }
  },
  "type": "object",
  "propertyVocab": "unit_category",
  "properties": {
    "about": {
      "type": "string"
    }
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": {
      "$ref": "#/$defs/squad"
    }
  }
}
